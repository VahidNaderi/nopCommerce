<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>NopCommerce.Nop.Services</id>
    <version>4.60.4.0</version>
    <authors>nopPlus</authors>
    <description>Nop.Web.Framework is a class library project containing some common presentation things for Nop.Web project</description>
    <language>en-US</language>
    <projectUrl>https://www.nopcommerce.com/</projectUrl>
    <license type="file">license.txt</license>
    <icon>nopcommerce_logo-128x128.png</icon>
    <references>
      <reference file="Nop.Core.dll" />
      <reference file="Nop.Data.dll" />
      <reference file="Nop.Services.dll" />
    </references>
    <dependencies>
      <dependency id="Azure.Storage.Blobs" version="12.15.0" />
      <dependency id="ClosedXML" version="0.100.3" />
      <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="2.8.2.3" />
      <dependency id="MailKit" version="3.4.3" />
      <dependency id="MaxMind.GeoIP2" version="5.1.0" />
      <dependency id="QuestPDF" version="2022.12.1" />
      <dependency id="System.ServiceModel.Http" version="4.10.0" />
      <dependency id="SkiaSharp" version="2.88.3" />
      <dependency id="SkiaSharp.NativeAssets.Linux.NoDependencies" version="2.88.3" />
      <dependency id="Svg.Skia" version="0.5.18" />
      <dependency id="System.Linq.Dynamic.Core" version="1.3.1" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Libraries\Nop.Services\bin\Release\net7.0\*.dll" target="lib" />
    <file src="license.txt" />
    <file src="nopcommerce_logo-128x128.png"/>
  </files>
</package>