<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>NopCommerce.Nop.Web.Framework</id>
    <version>4.60.4.0</version>
    <authors>nopPlus</authors>
    <description>Nop.Web.Framework is a class library project containing some common presentation things for Nop.Web project</description>
    <language>en-US</language>
    <projectUrl>https://www.nopcommerce.com/</projectUrl>
    <license type="file">license.txt</license>
    <icon>nopcommerce_logo-128x128.png</icon>
    <references>
      <reference file="Nop.Core.dll" />
      <reference file="Nop.Data.dll" />
      <reference file="Nop.Services.dll" />
      <reference file="Nop.Web.Framework.dll" />
    </references>
    <dependencies>
      <dependency id="FluentValidation.AspNetCore" version="11.2.2" />
      <dependency id="LigerShark.WebOptimizer.Core" version="3.0.380" />
      <dependency id="WebMarkupMin.AspNetCore7" version="2.13.8" />
      <dependency id="WebMarkupMin.NUglify" version="2.13.6" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Presentation\Nop.Web.Framework\bin\Release\net7.0\*.dll" target="lib/net7.0" />
    <file src="..\Presentation\Nop.Web.Framework\bin\Release\net7.0\*.pdb" target="lib/net7.0" />
    <file src="license.txt" />
    <file src="nopcommerce_logo-128x128.png"/>
  </files>
</package>