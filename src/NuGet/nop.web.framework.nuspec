    <license type="file">license.txt</license>
    <icon>nopcommerce_logo-128x128.png</icon>
    <references>
      <reference file="Nop.Web.Framework.dll" />
    </references>
    <dependencies>
      <dependency id="NopCommerce.Nop.Core" version="4.60.4.1" />
      <dependency id="NopCommerce.Nop.Data" version="4.60.4.1" />
      <dependency id="NopCommerce.Nop.Services" version="4.60.4.1" />
      
      <dependency id="FluentValidation.AspNetCore" version="11.3.0" />
      <dependency id="LigerShark.WebOptimizer.Core" version="3.0.426" />
      <dependency id="WebMarkupMin.AspNetCoreLatest" version="2.18.0" />
      <dependency id="WebMarkupMin.NUglify" version="2.18.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\Presentation\Nop.Web.Framework\bin\Release\net9.0\*.dll" target="lib/net7.0" />
